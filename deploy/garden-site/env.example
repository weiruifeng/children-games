NODE_ENV=production
PUBLIC_ORIGIN=https://garden.example.com
HOST=127.0.0.1
PORT=3009
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=garden_site
MYSQL_USER=garden_site_app
MYSQL_PASSWORD=REPLACE_WITH_DEPLOYMENT_SECRET
TRUST_PROXY=loopback
# Optional public media base; build-time value, never a secret.
# VITE_GARDEN_ASSET_BASE_URL=https://cdn.example.com/pinyin-garden/release-id/
# Backup service only: use a separate reader account with required dump privileges.
# GARDEN_BACKUP_DIR=/mnt/private-independent-backups/garden
# GARDEN_BACKUP_KEY=32_BYTE_BASE64_SECRET_STORE_SEPARATELY
