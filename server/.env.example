# Copy deploy/garden-site/local.env.example to .env.garden.local for local development.
# Production values and HTTPS/backup settings: deploy/garden-site/env.example.
PORT=3009
PUBLIC_ORIGIN=http://localhost:5173
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=children_games_garden_local
MYSQL_USER=replace-with-local-user
MYSQL_PASSWORD=replace-with-local-password
