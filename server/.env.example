# OpenAI-compatible LLM endpoint. Do not commit the corresponding .env file.
LLM_BASE_URL=https://your-llm-provider.example/v1
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=deepseek-v4-pro

# The NestJS API listens here; Vite proxies /api to this address in development.
PORT=3009

# Local MySQL for Game Studio development. The app account can only read and
# write data in children_games; use a separate migration/admin account for DDL.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=children_games
MYSQL_USER=children_games_app
MYSQL_PASSWORD=children_games_dev_2026!
