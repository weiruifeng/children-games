{
  "name": "@children-games/server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/server/src/garden-main.js",
    "start:dev": "nest start --entryFile garden-main --watch",
    "start:prod": "node dist/server/src/garden-main.js",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "start:garden-site": "node dist/server/src/garden-main.js",
    "migrate:garden": "node scripts/migrate-garden.mjs",
    "bootstrap:admin": "node scripts/bootstrap-admin.mjs",
    "test:garden-integration": "vitest run test/garden-site.integration.test.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "argon2": "^0.45.2",
    "express": "^5.3.0",
    "mysql2": "^3.24.5",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.6.7",
    "dotenv": "^18.0.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/express": "^5.0.6",
    "@types/node": "^20.17.0",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.6.2",
    "vitest": "^3.0.0"
  }
}
