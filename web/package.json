{
  "name": "@children-games/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "type-check": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:garden-site": "tsc -b && vite build --config vite.garden.config.ts",
    "dev:garden-site": "vite --config vite.garden.config.ts",
    "preview:garden-site": "vite preview --config vite.garden.config.ts",
    "test:garden-e2e": "playwright test --config playwright.garden.config.ts",
    "test:resources": "playwright test --config playwright.resources.config.ts"
  },
  "dependencies": {
    "@children-games/shared": "*",
    "phaser": "^3.87.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "fake-indexeddb": "^6.2.7",
    "sharp": "^0.35.5",
    "typescript": "~5.6.2",
    "vite": "^6.3.5",
    "vitest": "^3.0.0"
  }
}
