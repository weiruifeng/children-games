{
  "name": "children-games",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "shared",
    "web",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n web,server -c cyan,magenta \"npm run dev -w web\" \"npm run start:dev -w server\"",
    "dev:web": "npm run dev -w web",
    "dev:server": "npm run start:dev -w server",
    "build": "npm run validate:garden-content && npm run build -w shared && npm run build -w web && npm run build -w server",
    "type-check": "npm run type-check -w shared && npm run type-check -w web && npm run type-check -w server",
    "dev:pinyin": "npm run dev -w web -- --open /experiments/pinyin-garden/",
    "validate:garden-content": "node scripts/validate-garden-content.mjs",
    "build:garden-site": "npm run build",
    "start:garden-site": "npm run start:garden-site -w server",
    "dev:garden-site": "npm run dev:garden-site -w web",
    "migrate:garden": "npm run migrate:garden -w server",
    "bootstrap:admin": "npm run bootstrap:admin -w server",
    "local:garden": "node scripts/dev-garden-local.mjs",
    "lint": "eslint web/src shared/src server/src server/test web/e2e --max-warnings 0",
    "format:check": "prettier --check \"web/src/**/*.{ts,tsx,css}\" \"shared/src/**/*.ts\" \"server/src/**/*.ts\" \"server/test/**/*.ts\" \"web/e2e/**/*.ts\" \"web/*.{ts,json}\" \"server/*.json\" \"shared/*.json\" package.json eslint.config.mjs .prettierrc.json server/scripts/test-garden-integration.mjs",
    "format": "prettier --write \"web/src/**/*.{ts,tsx,css}\" \"shared/src/**/*.ts\" \"server/src/**/*.ts\" \"server/test/**/*.ts\" \"web/e2e/**/*.ts\" \"web/*.{ts,json}\" \"server/*.json\" \"shared/*.json\" package.json eslint.config.mjs .prettierrc.json server/scripts/test-garden-integration.mjs",
    "test:unit": "npm test -w web && npm test -w server",
    "test:integration": "npm run test:garden-integration -w server",
    "test:e2e": "npm run test:e2e -w web",
    "check": "npm run lint && npm run format:check && npm run type-check && npm run test:unit && npm run build && node scripts/check-garden-release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "concurrently": "^9.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "typescript-eslint": "^8.72.2"
  },
  "engines": {
    "node": ">=24"
  }
}
